<style>
:root{--bg:#eef4f2;--sf:#fff;--ink:#14293a;--mu:#5a6b75;--tl:#0a8a82;--ts:#dff1ee;--ln:#d5dfdb;--nv:#15324a;--am:#f5b82e;--on:#fff;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0b1820;--sf:#13252f;--ink:#e6f0ef;--mu:#9db1b8;--tl:#35c8bc;--ts:#17383d;--ln:#26404b;--nv:#0f3a4f;--on:#04282a}}
:root[data-theme="dark"]{--bg:#0b1820;--sf:#13252f;--ink:#e6f0ef;--mu:#9db1b8;--tl:#35c8bc;--ts:#17383d;--ln:#26404b;--nv:#0f3a4f;--on:#04282a}
*{box-sizing:border-box}html{scroll-padding-top:calc(80px + env(safe-area-inset-top,0px));scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:400 15px/1.7 Poppins,system-ui,-apple-system,"Segoe UI",Arial,sans-serif;transition:background .3s,color .3s}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:20}
.wrap{width:min(1060px,100% - 32px);margin:auto}
#bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;background:var(--bg);border-bottom:1px solid var(--ln)}
#bar .wrap{display:flex;align-items:center;gap:8px;padding:10px 0}
.brand{flex:none;display:flex;align-items:center;gap:9px;font-weight:700;letter-spacing:-.02em;cursor:pointer;border:0;background:none;color:var(--ink);font-family:inherit;font-size:1rem}
.mark{width:32px;height:32px;border-radius:10px;background:var(--tl);color:var(--on);display:grid;place-items:center;font-size:16px}
#dots{flex:1;display:flex;gap:4px;overflow-x:auto;scrollbar-width:none}#dots::-webkit-scrollbar{display:none}
.dot{flex:none;border:0;background:none;color:var(--mu);border-radius:999px;padding:7px 13px;font:500 .82rem Poppins,system-ui;cursor:pointer;white-space:nowrap;transition:background .2s,color .2s}
.dot:hover{background:var(--ts);color:var(--ink)}.dot.on{background:var(--nv);color:#fff}.dot.done:not(.on){color:var(--tl)}.dot.done:not(.on)::after{content:" ✓";font-size:.75em}
#theme{flex:none;width:36px;height:36px;border-radius:50%;border:1px solid var(--ln);background:var(--sf);color:var(--ink);cursor:pointer;font-size:1rem}
#prog{height:4px;background:var(--ln)}#prog i{display:block;height:100%;width:0;background:var(--tl);transition:width .4s}
.stage{display:none;padding:28px 0 56px}.stage.on{display:block;animation:fade .3s}@keyframes fade{from{opacity:0}}
.hero{background:var(--nv);color:#fff;border-radius:28px;padding:clamp(26px,5vw,56px);position:relative;overflow:hidden;isolation:isolate;display:grid;grid-template-columns:1.2fr .8fr;gap:24px;align-items:center}
.hero h1{font-size:clamp(1.9rem,4.6vw,3rem);line-height:1.1;letter-spacing:-.04em;font-weight:700;margin:0 0 12px}.hero p{margin:0 0 10px;color:#d9ebe7;max-width:520px}
.hero .lead{font-weight:600;color:#fff;font-size:1.08rem}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0 22px}.chips span{border:1px solid #ffffff55;border-radius:999px;padding:4px 13px;font-size:.8rem}
.hv{position:relative;height:230px}.hv .b{position:absolute;border-radius:50%;background:radial-gradient(circle at 30% 30%,#ffffff66,#35c8bc33);border:1px solid #ffffff44;animation:fl 6s ease-in-out infinite}
@keyframes fl{50%{transform:translateY(-16px)}}.hv .bulb{position:absolute;left:50%;top:50%;width:92px;height:92px;margin:-46px;border-radius:50%;background:var(--am);box-shadow:0 0 0 14px #f5b82e33,0 0 60px 20px #f5b82e88;display:grid;place-items:center;font-size:2.2rem;cursor:pointer;border:0;transition:transform .2s}.hv .bulb:active{transform:scale(.92)}
.hv .bulb.off{background:#2b4a5d;box-shadow:none;filter:grayscale(1)}
h2{font-size:clamp(1.3rem,2.6vw,1.7rem);letter-spacing:-.03em;margin:2px 0 10px;line-height:1.25;font-weight:700}h3{margin:22px 0 8px;font-size:1.02rem;font-weight:600}
.kick{font-size:.85rem;font-weight:600;color:var(--tl);margin-bottom:2px}
.card{background:var(--sf);border:1px solid var(--ln);border-radius:22px;padding:clamp(18px,3.5vw,34px)}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:14px}.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.tile{border:1px solid var(--ln);background:var(--sf);border-radius:16px;padding:16px;text-align:left;color:var(--ink);font:inherit;position:relative}
button.tile{cursor:pointer;transition:border-color .2s,transform .2s,background .2s}button.tile:hover{transform:translateY(-3px);border-color:var(--tl)}
.tile .ic{display:inline-grid;place-items:center;min-width:34px;height:34px;padding:0 6px;margin-bottom:8px;border-radius:10px;background:var(--ts);color:var(--tl);font-weight:700;font-size:.85rem}
.tile b{display:block;font-weight:600}.tile small{color:var(--mu);font-size:.82rem;line-height:1.4;display:block}
.tile.ok,.tile.seen{border-color:var(--tl);background:var(--ts)}.tile.ok .ic{background:var(--tl);color:var(--on)}.tile.ok .ic::after{content:"✓"}.tile.ok .ic span{display:none}
.tile.seen::after{content:"✓";position:absolute;right:14px;top:12px;color:var(--tl);font-weight:700}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:12px;background:var(--tl);color:var(--on);font:600 .95rem Poppins,system-ui;padding:12px 20px;cursor:pointer;text-decoration:none;transition:transform .15s,filter .15s}
.btn:hover{filter:brightness(1.1);transform:translateY(-1px)}.btn:active{transform:scale(.97)}.btn.alt{background:var(--ts);color:var(--ink)}.btn.sm{padding:8px 14px;font-size:.85rem}
.nav{display:flex;justify-content:space-between;gap:10px;margin-top:26px;flex-wrap:wrap}
.call{background:var(--ts);border-left:4px solid var(--tl);border-radius:6px 14px 14px 6px;padding:12px 16px;margin:16px 0}
.eq{font-weight:600;background:var(--bg);border-radius:10px;padding:8px 12px;display:inline-block}
ol.flow{list-style:none;padding:0;margin:0}ol.flow li{position:relative;padding:8px 10px 8px 56px;margin-bottom:4px;border-radius:12px;cursor:pointer;transition:background .2s;min-height:48px}
ol.flow li:hover{background:var(--ts)}ol.flow li::before{content:attr(data-n);position:absolute;left:8px;top:8px;width:32px;height:32px;border-radius:10px;background:var(--ts);color:var(--tl);display:grid;place-items:center;font-weight:700;font-size:.85rem;transition:background .2s}
ol.flow li.dn{color:var(--mu);text-decoration:line-through}ol.flow li.dn::before{content:"✓";background:var(--tl);color:var(--on)}
.stepnum{display:inline-grid;place-items:center;min-width:30px;height:30px;border-radius:9px;background:var(--nv);color:#fff;font-weight:700;margin-right:8px;font-size:.9rem}
.lab{display:grid;grid-template-columns:1.1fr .9fr;gap:18px;margin:16px 0;align-items:start}
.cvw{background:linear-gradient(var(--bg),var(--ts));border:1px solid var(--ln);border-radius:18px;padding:6px}#lab{width:100%;height:auto;display:block}
.seg{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}.seg button{flex:1;min-width:90px;border:1.5px solid var(--ln);background:var(--sf);color:var(--ink);border-radius:12px;padding:9px 8px;font:500 .88rem Poppins,system-ui;cursor:pointer;transition:all .2s}
.seg button.on{background:var(--nv);border-color:var(--nv);color:#fff}
input[type=range]{width:100%;padding:0;border:0;accent-color:var(--tl);height:28px}
.read{display:grid;gap:8px;margin-top:12px}.read div{background:var(--ts);border-radius:12px;padding:9px 13px;font-size:.88rem}.read b{display:block;font-weight:600;font-size:.95rem}
.q{display:flex;gap:8px;flex-wrap:wrap}.q button{flex:1;min-width:150px;border:1.5px solid var(--ln);background:var(--sf);color:var(--ink);border-radius:12px;padding:10px 12px;font:500 .88rem Poppins,system-ui;cursor:pointer;transition:all .2s}
.q button:hover{border-color:var(--tl)}.q button.good{background:var(--tl);color:var(--on);border-color:var(--tl)}.q button.bad{border-color:#d1495b;background:#d1495b22}
.pc{border:1.5px solid var(--ln);background:var(--sf);color:var(--ink);border-radius:999px;padding:7px 14px;font:500 .85rem Poppins,system-ui;cursor:pointer;margin:0 6px 6px 0}.pc:hover{border-color:var(--tl);background:var(--ts)}
label{display:block;font-weight:500;margin:14px 0 5px;font-size:.92rem}input,textarea{width:100%;padding:10px 13px;border:1.5px solid var(--ln);border-radius:12px;background:var(--sf);color:var(--ink);font:inherit;transition:border-color .2s}textarea{min-height:76px;resize:vertical}
input:focus,textarea:focus{border-color:var(--tl)}input:focus-visible,textarea:focus-visible,button:focus-visible,a:focus-visible,summary:focus-visible,li:focus-visible{outline:3px solid var(--tl);outline-offset:2px}
.tw{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:520px}th,td{border:1px solid var(--ln);padding:8px;text-align:left}th{background:var(--ts);font-weight:600}
.sim{width:100%;height:560px;border:1px solid var(--ln);border-radius:16px;background:#fff}.muted{color:var(--mu);font-size:.88rem}
.bar{height:10px;background:var(--ln);border-radius:9px;overflow:hidden;max-width:420px}.bar i{display:block;height:100%;width:0;background:var(--tl);transition:width .5s}
#ck{list-style:none;padding:0;margin:16px 0}#ck li{padding:6px 0;color:var(--mu)}#ck li.y{color:var(--ink);font-weight:500}#ck li::before{content:"○";margin-right:10px;color:var(--mu)}#ck li.y::before{content:"✓";color:var(--tl);font-weight:700}
details{border:1px solid var(--ln);border-radius:14px;padding:12px 16px;margin:10px 0;background:var(--sf)}summary{font-weight:600;cursor:pointer}
#toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translate(-50%,30px);background:var(--nv);color:#fff;padding:10px 20px;border-radius:999px;font-size:.88rem;opacity:0;pointer-events:none;transition:all .3s;z-index:30}#toast.on{opacity:1;transform:translate(-50%,0)}
@media(max-width:760px){.hero,.lab,.g2,.g3{grid-template-columns:1fr}.g4{grid-template-columns:1fr 1fr}.hv{height:150px}.hv .bulb{width:70px;height:70px;margin:-35px;font-size:1.7rem}.brandname{display:none}.sim{height:480px}.stage{padding:18px 0 36px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
@media print{#bar,#toast,.nav,.no-print,.sim{display:none!important}.stage{display:block!important}.card{break-inside:avoid}}
</style>
