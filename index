const cv=$("lab"),cx=cv.getContext("2d");let mode="salt",conc=50,P=[],glow=0;
function seed(){const n=mode==="water"?0:Math.round(conc*.7)+6,ion=mode==="salt";P=[];for(let i=0;i<n;i++)P.push({x:70+Math.random()*180,y:120+Math.random()*100,vx:(Math.random()-.5)*(ion?2.4:.8),vy:(Math.random()-.5)*(ion?2.4:.8),t:ion?(i%2?1:-1):0})}
function info(){const on=mode==="salt",b=on?(conc>66?"Menyala terang":conc>28?"Menyala redup":"Menyala sangat redup"):"Padam";$("r1").textContent=b;$("r2").textContent=mode==="salt"?"Ion Na⁺ dan Cl⁻ bergerak bebas":mode==="sugar"?"Molekul gula netral":"Hanya molekul air";$("r3").textContent=mode==="salt"?"Elektrolit":mode==="sugar"?"Nonelektrolit":"Tidak ada zat terlarut";$("cv").textContent=conc+"%";$("cc").disabled=mode==="water"}
