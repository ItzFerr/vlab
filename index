 const tgt=mode==="salt"?.2+conc/100*.8:0;glow+=(tgt-glow)*.06;cx.clearRect(0,0,320,250);
 cx.strokeStyle=ink;cx.lineWidth=2.5;cx.lineJoin="round";
 cx.beginPath();cx.moveTo(108,70);cx.lineTo(108,170);cx.moveTo(212,70);cx.lineTo(212,170);cx.moveTo(108,70);cx.lineTo(108,52);cx.lineTo(140,52);cx.moveTo(212,70);cx.lineTo(212,52);cx.lineTo(180,52);cx.stroke();
 if(glow>.02){const g=cx.createRadialGradient(160,40,4,160,40,20+glow*50);g.addColorStop(0,"rgba(255,214,90,"+glow+")");g.addColorStop(1,"rgba(255,214,90,0)");cx.fillStyle=g;cx.fillRect(60,0,200,110)}
 cx.beginPath();cx.arc(160,40,19,0,7);cx.fillStyle=glow>.02?"rgba(255,206,60,"+(.35+glow*.65)+")":"rgba(120,140,150,.35)";cx.fill();cx.stroke();cx.strokeRect(150,56,20,8);
 cx.fillStyle="rgba(70,160,230,.30)";cx.fillRect(52,112,216,108);cx.beginPath();cx.moveTo(48,96);cx.lineTo(52,224);cx.quadraticCurveTo(54,232,64,232);cx.lineTo(256,232);cx.quadraticCurveTo(266,232,268,224);cx.lineTo(272,96);cx.stroke();
 P.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<60||p.x>260)p.vx*=-1;if(p.y<120||p.y>222)p.vy*=-1;
